<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>0.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
    <TargetFramework Condition="'$(McmWindowsDesktop)' != 'true'">net10.0</TargetFramework>
    <TargetFramework Condition="'$(McmWindowsDesktop)' == 'true'">net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <PropertyGroup Condition="'$(McmWindowsDesktop)' == 'true'">
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>
  <ItemGroup Condition="'$(McmWindowsDesktop)' == 'true'">
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" />
    <!-- Only the version resource DLL is used; no framework registration/deployment targets. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" GeneratePathProperty="true"
                      PrivateAssets="all" ExcludeAssets="build;buildTransitive" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../MeshCoreMessenger.Core/MeshCoreMessenger.Core.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <McmNativeArch Condition="'$(RuntimeIdentifier)' == 'osx-x64' Or ('$(RuntimeIdentifier)' == '' And '$(NETCoreSdkRuntimeIdentifier)' == 'osx-x64')">x86_64</McmNativeArch>
    <McmNativeArch Condition="'$(McmNativeArch)' == ''">arm64</McmNativeArch>
  </PropertyGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX')) And '$(McmWindowsDesktop)' != 'true'">
    <None Include="$(BaseIntermediateOutputPath)native/$(Configuration)/$(McmNativeArch)/libMcmNotifications.dylib" Link="libMcmNotifications.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildMcmNotifications" BeforeTargets="PrepareForBuild" Condition="$([MSBuild]::IsOSPlatform('OSX')) And '$(McmWindowsDesktop)' != 'true'"
          Inputs="$(MSBuildProjectDirectory)/Native/Notifications.m;$(MSBuildProjectFullPath)" Outputs="$(BaseIntermediateOutputPath)native/$(Configuration)/$(McmNativeArch)/libMcmNotifications.dylib">
    <MakeDir Directories="$(BaseIntermediateOutputPath)native/$(Configuration)/$(McmNativeArch)" />
    <Exec Command="xcrun clang -arch $(McmNativeArch) -mmacosx-version-min=11.0 -fobjc-arc -dynamiclib -install_name @rpath/libMcmNotifications.dylib -framework Foundation -framework UserNotifications &quot;$(MSBuildProjectDirectory)/Native/Notifications.m&quot; -o &quot;$(BaseIntermediateOutputPath)native/$(Configuration)/$(McmNativeArch)/libMcmNotifications.dylib&quot;" />
  </Target>
  <Import Project="Native/WindowsNotificationResources.targets" Condition="'$(McmWindowsDesktop)' == 'true'" />
</Project>
