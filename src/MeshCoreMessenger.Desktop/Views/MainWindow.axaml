<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MeshCoreMessenger.Desktop.ViewModels"
        xmlns:controls="using:MeshCoreMessenger.Desktop.Controls"
        x:Class="MeshCoreMessenger.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1040" Height="700" MinWidth="560" MinHeight="440"
        SizeChanged="OnWindowSizeChanged">
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Padding="18,11"
            BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Status}" FontSize="12" Opacity="0.62" />
          <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                     Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
          <StackPanel Margin="0,0,6,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding ConnectionStatus}" HorizontalAlignment="Right" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ActiveProfileDisplayName, StringFormat='Профиль: {0}'}"
                       HorizontalAlignment="Right" FontSize="11" Opacity="0.62" />
            <TextBlock Text="{Binding ActiveNodeDisplayName, StringFormat='Нода: {0}'}"
                       ToolTip.Tip="{Binding ActiveNodePublicKeyHex}"
                       HorizontalAlignment="Right" FontSize="11" Opacity="0.72" />
          </StackPanel>
          <Button Content="Настройки" Command="{Binding ToggleConnectionSettingsCommand}" />
          <Button Content="Подключить" Command="{Binding ConnectCommand}" />
          <Button Content="Отключить" Command="{Binding DisconnectCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid x:Name="ConversationColumns" ColumnDefinitions="340,*">
        <Border x:Name="DirectoryPane" Grid.Column="0"
                IsVisible="{Binding Navigation.IsDirectoryVisible}"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="0,0,1,0">
          <Grid RowDefinitions="Auto,Auto,*">
            <StackPanel Grid.Row="0" Margin="14,12,14,8" Spacing="7">
              <Grid>
                <StackPanel>
                  <TextBlock Text="История ноды" FontSize="12" Opacity="0.62" />
                  <ComboBox ItemsSource="{Binding KnownNodes}"
                            SelectedItem="{Binding ViewedNode, Mode=OneWay}"
                            IsEnabled="{Binding CanSelectViewedNode}"
                            SelectionChanged="OnNodeSelectionChanged"
                            PlaceholderText="Выберите сохранённую ноду">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:KnownNodeListItem">
                        <TextBlock Text="{Binding SelectorLabel}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
              </Grid>
              <TextBlock Text="{Binding ViewedNodePublicKeyHex}" IsVisible="{Binding HasViewedNode}"
                         FontFamily="Monospace" FontSize="10" TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding ViewedNodePublicKeyHex}" Opacity="0.55" />
            </StackPanel>

            <Border Grid.Row="1" Padding="10,7"
                    BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="0,1,0,1">
              <ListBox ItemsSource="{Binding Navigation.Tabs}"
                       SelectedItem="{Binding Navigation.SelectedTab, Mode=OneWay}"
                       SelectionChanged="OnNavigationTabSelectionChanged" Background="Transparent">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:MessengerNavigationTabItem">
                    <TextBlock Text="{Binding Title}" Margin="8,4" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>

            <Grid Grid.Row="2" RowDefinitions="Auto,*">
              <ComboBox Grid.Row="0" Margin="14,10,14,0"
                        ItemsSource="{Binding Navigation.ChannelFilters}"
                        SelectedItem="{Binding Navigation.SelectedChannelFilter, Mode=TwoWay}"
                        IsVisible="{Binding Navigation.IsChannelTab}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ChannelAccessFilterItem"><TextBlock Text="{Binding Title}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <ScrollViewer Grid.Row="1">
                <StackPanel Margin="8,8,8,14" Spacing="5">
                  <TextBlock Text="{Binding Navigation.EmptyText}" IsVisible="{Binding Navigation.IsEmpty}"
                             Margin="10,24" HorizontalAlignment="Center" Opacity="0.55" />
                  <TextBlock Text="{Binding Navigation.PrimaryGroupTitle}"
                             IsVisible="{Binding Navigation.HasPrimaryConversations}"
                             Margin="8,5,8,2" FontSize="12" FontWeight="SemiBold" Opacity="0.65" />
                  <ListBox ItemsSource="{Binding Navigation.PrimaryConversations}"
                           SelectedItem="{Binding Navigation.SelectedConversation, Mode=OneWay}"
                           SelectionChanged="OnConversationSelectionChanged" Background="Transparent">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ConversationListItem">
                        <Grid Margin="5,7" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <StackPanel Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding ActivityTime}" FontSize="10" Opacity="0.55" />
                            <Border IsVisible="{Binding HasUnreadMessages}" Background="#1976D2"
                                    CornerRadius="9" Padding="6,1" HorizontalAlignment="Right">
                              <TextBlock Text="{Binding UnreadLabel}" FontSize="9" Foreground="White" />
                            </Border>
                          </StackPanel>
                          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding TypeLabel}"
                                     FontSize="10" Opacity="0.55" />
                          <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Preview}"
                                     TextTrimming="CharacterEllipsis" Opacity="0.72" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock Text="{Binding Navigation.UnknownGroupTitle}"
                             IsVisible="{Binding Navigation.HasUnknownConversations}"
                             Margin="8,12,8,2" FontSize="12" FontWeight="SemiBold" Opacity="0.65" />
                  <ListBox ItemsSource="{Binding Navigation.UnknownConversations}"
                           SelectedItem="{Binding Navigation.SelectedConversation, Mode=OneWay}"
                           SelectionChanged="OnConversationSelectionChanged" Background="Transparent">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ConversationListItem">
                        <Grid Margin="5,7" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <StackPanel Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding ActivityTime}" FontSize="10" Opacity="0.55" />
                            <Border IsVisible="{Binding HasUnreadMessages}" Background="#1976D2"
                                    CornerRadius="9" Padding="6,1" HorizontalAlignment="Right">
                              <TextBlock Text="{Binding UnreadLabel}" FontSize="9" Foreground="White" />
                            </Border>
                          </StackPanel>
                          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Preview}"
                                     TextTrimming="CharacterEllipsis" Opacity="0.72" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <Button Content="Показать ещё" Command="{Binding Navigation.LoadMoreCommand}"
                          IsVisible="{Binding Navigation.CanLoadMore}" HorizontalAlignment="Stretch" Margin="4,8" />
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Grid>
        </Border>

        <Grid x:Name="DetailPane" Grid.Column="1"
              IsVisible="{Binding Navigation.IsDetailVisible}" RowDefinitions="Auto,*">
          <Border Padding="18,12" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*">
              <Button Content="Назад" Command="{Binding Navigation.BackCommand}"
                      IsVisible="{Binding Navigation.CanNavigateBack}" Margin="0,0,10,0" />
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{Binding Navigation.SelectedTitle}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Navigation.SelectedMetadata}" FontSize="11"
                           TextWrapping="Wrap" Opacity="0.65" />
                <TextBlock Text="{Binding Navigation.SelectedIdentity}" FontFamily="Monospace" FontSize="10"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Navigation.SelectedIdentity}"
                           Opacity="0.48" />
                <Button Content="{Binding Navigation.History.UnreadLabel}"
                        Command="{Binding Navigation.History.JumpToFirstUnreadCommand}"
                        IsVisible="{Binding Navigation.History.HasUnreadMessages}"
                        HorizontalAlignment="Left" Margin="0,4,0,0" />
                <TextBlock Text="{Binding Navigation.History.ReadErrorMessage}"
                           IsVisible="{Binding Navigation.History.HasReadError}"
                           Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />
              </StackPanel>
            </Grid>
          </Border>
          <Grid Grid.Row="1">
            <TextBlock Text="Выберите запись слева" IsVisible="{Binding !Navigation.HasSelection}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" />
            <TextBlock Text="У этой записи пока нет сообщений" IsVisible="{Binding Navigation.History.HasEmptyHistory}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.35" />
            <Grid IsVisible="{Binding Navigation.History.HasMessages}" RowDefinitions="Auto,*">
              <Button Grid.Row="0" Content="Загрузить более ранние"
                      Command="{Binding Navigation.History.LoadOlderCommand}"
                      IsVisible="{Binding Navigation.History.CanLoadOlder}"
                      HorizontalAlignment="Center" Margin="8" />
              <controls:VirtualizedHistoryListBox x:Name="HistoryList"
                       Grid.Row="1" ItemsSource="{Binding Navigation.History.Messages}"
                       Padding="18" SelectionMode="Single" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:HistoryMessageListItem">
                    <Border Margin="0,4" Padding="12,9" CornerRadius="8"
                            Background="{DynamicResource ThemeControlLowBrush}"
                            MaxWidth="680" HorizontalAlignment="Stretch">
                      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                        <TextBlock Text="{Binding Direction}" FontSize="11" FontWeight="SemiBold" Opacity="0.68" />
                        <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding ReceivedTime}"
                                   FontSize="11" Opacity="0.55" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ContentLabel}"
                                   IsVisible="{Binding HasContentLabel}" FontSize="10" Opacity="0.55" />
                        <SelectableTextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="0,4,0,0"
                                             Text="{Binding Body}" TextWrapping="Wrap" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </controls:VirtualizedHistoryListBox>
              <StackPanel Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                          Margin="0,0,0,14" Spacing="6">
                <Button Content="{Binding Navigation.History.PendingNewMessagesLabel}"
                        Command="{Binding Navigation.History.JumpToLatestCommand}"
                        IsVisible="{Binding Navigation.History.HasPendingNewMessages}" />
                <Button Content="Загрузить более новые"
                        Command="{Binding Navigation.History.LoadNewerCommand}"
                        IsVisible="{Binding Navigation.History.CanLoadNewer}" />
              </StackPanel>
            </Grid>
          </Grid>
        </Grid>
      </Grid>

      <Border IsVisible="{Binding IsConnectionSettingsOpen}" Width="370" HorizontalAlignment="Right"
              Background="{DynamicResource ThemeBackgroundBrush}"
              BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1,0,0,0"
              Padding="16" BoxShadow="-8 0 20 0 #40000000">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Профиль подключения" FontSize="18" FontWeight="SemiBold" />
            <Button Grid.Column="1" Content="Закрыть" Command="{Binding CloseConnectionSettingsCommand}" />
          </Grid>
          <ScrollViewer Grid.Row="1" Margin="0,14,0,0">
            <StackPanel Spacing="8">
              <ComboBox ItemsSource="{Binding Profiles.AvailableProfiles}"
                        SelectedItem="{Binding Profiles.SelectedProfile, Mode=TwoWay}"
                        PlaceholderText="Сохранённые профили">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ConnectionProfileListItem"><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Content="Новый профиль" Command="{Binding Profiles.NewProfileCommand}" HorizontalAlignment="Left" />
              <TextBlock Text="Название" />
              <TextBox Text="{Binding Profiles.ProfileName, Mode=TwoWay}" />
              <TextBlock Text="Транспорт" />
              <ComboBox ItemsSource="{Binding Profiles.TransportKinds}"
                        SelectedItem="{Binding Profiles.SelectedTransport, Mode=TwoWay}" />
              <Grid IsVisible="{Binding Profiles.IsTcp}" ColumnDefinitions="90,*"
                    RowDefinitions="Auto,Auto" RowSpacing="6">
                <TextBlock Text="Host" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding Profiles.TcpHost, Mode=TwoWay}" />
                <TextBlock Grid.Row="1" Text="Port" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Profiles.TcpPort, Mode=TwoWay}" />
              </Grid>
              <StackPanel IsVisible="{Binding Profiles.IsSerial}" Spacing="7">
                <Grid ColumnDefinitions="90,*">
                  <TextBlock Text="Serial port" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding Profiles.AvailableSerialPorts}"
                            Text="{Binding Profiles.SerialPortName, Mode=TwoWay}" IsEditable="True"
                            PlaceholderText="/dev/cu… или COM…" />
                </Grid>
                <Button Content="Обновить порты" Command="{Binding Profiles.RefreshPortsCommand}"
                        HorizontalAlignment="Right" />
                <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto" RowSpacing="6">
                  <TextBlock Text="Baud rate" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding Profiles.BaudRate, Mode=TwoWay}" />
                  <TextBlock Grid.Row="1" Text="Open delay, ms" VerticalAlignment="Center" />
                  <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Profiles.OpenDelayMilliseconds, Mode=TwoWay}" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <CheckBox Content="DTR" IsChecked="{Binding Profiles.DtrEnable, Mode=TwoWay}" />
                  <CheckBox Content="RTS" IsChecked="{Binding Profiles.RtsEnable, Mode=TwoWay}" />
                </StackPanel>
              </StackPanel>
              <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto" RowSpacing="6">
                <TextBlock Text="Command timeout, ms" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding Profiles.CommandTimeoutMilliseconds, Mode=TwoWay}" />
                <TextBlock Grid.Row="1" Text="ACK timeout, ms" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1"
                         Text="{Binding Profiles.AcknowledgementTimeoutMilliseconds, Mode=TwoWay}" />
              </Grid>
              <CheckBox Content="Автоподключение при запуске" IsChecked="{Binding Profiles.AutoConnect, Mode=TwoWay}" />
              <CheckBox Content="Повторять подключение после обрыва" IsChecked="{Binding Profiles.Reconnect, Mode=TwoWay}" />
              <Button Content="Сохранить и выбрать" Command="{Binding Profiles.SaveAndSelectCommand}" />
              <TextBlock Text="{Binding Profiles.Status}" TextWrapping="Wrap" Opacity="0.7" />
              <TextBlock Text="{Binding Profiles.ErrorMessage}" IsVisible="{Binding Profiles.HasError}"
                         TextWrapping="Wrap" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
