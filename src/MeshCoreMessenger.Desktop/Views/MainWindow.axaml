<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MeshCoreMessenger.Desktop.ViewModels"
        x:Class="MeshCoreMessenger.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="900"
        Height="600"
        MinWidth="640"
        MinHeight="420">
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0"
            Padding="16,10"
            BorderBrush="{DynamicResource ThemeBorderLowBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding Title}"
                     FontSize="20"
                     FontWeight="SemiBold" />
          <TextBlock Text="{Binding Status}"
                     Opacity="0.7" />
          <TextBlock Text="{Binding ErrorMessage}"
                     IsVisible="{Binding HasError}"
                     Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />
        </StackPanel>
        <Border Grid.Column="1"
                Padding="10,5"
                CornerRadius="10"
                Background="{DynamicResource ThemeControlMidBrush}"
                VerticalAlignment="Center">
          <TextBlock Text="{Binding ConnectionStatus}" />
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="320,*">
      <Border Grid.Column="0"
              BorderBrush="{DynamicResource ThemeBorderLowBrush}"
              BorderThickness="0,0,1,0">
        <ListBox ItemsSource="{Binding Conversations}"
                 SelectedItem="{Binding SelectedConversation, Mode=OneWay}"
                 SelectionChanged="OnConversationSelectionChanged"
                 Padding="8">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ConversationListItem">
              <Grid Margin="4,7" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0"
                           Text="{Binding Title}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="0"
                           Grid.Column="1"
                           Margin="8,0,0,0"
                           Text="{Binding ActivityTime}"
                           FontSize="11"
                           Opacity="0.6" />
                <TextBlock Grid.Row="1"
                           Grid.ColumnSpan="2"
                           Text="{Binding Preview}"
                           TextTrimming="CharacterEllipsis"
                           Opacity="0.7" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Grid Grid.Column="1" RowDefinitions="Auto,*">
        <Border Padding="16,12"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="0,0,0,1">
          <TextBlock Text="{Binding SelectedConversation.Title}"
                     FontSize="17"
                     FontWeight="SemiBold" />
        </Border>
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Messages}"
                 Padding="16"
                 SelectionMode="Single">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:HistoryMessageListItem">
              <Border Margin="0,4"
                      Padding="12,8"
                      CornerRadius="8"
                      Background="{DynamicResource ThemeControlLowBrush}"
                      MaxWidth="640"
                      HorizontalAlignment="Stretch">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                  <TextBlock Text="{Binding Direction}"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Opacity="0.7" />
                  <TextBlock Grid.Column="1"
                             Margin="12,0,0,0"
                             Text="{Binding ReceivedTime}"
                             FontSize="11"
                             Opacity="0.6" />
                  <TextBlock Grid.Row="1"
                             Grid.ColumnSpan="2"
                             Margin="0,4,0,0"
                             Text="{Binding Body}"
                             TextWrapping="Wrap" />
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Grid>
  </Grid>
</Window>
