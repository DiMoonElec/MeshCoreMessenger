<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chat="using:MeshCoreMessenger.Desktop.Views.Chat"
        x:Class="MeshCoreMessenger.Desktop.Views.Chat.HistoryClearDialog" x:DataType="chat:HistoryClearDialog"
        Title="Удалить историю переписки?" Width="420" MinWidth="280" MaxHeight="600"
        SizeToContent="Height" CanResize="True" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ChatSurfaceBrush}">
  <Grid Margin="20" RowDefinitions="*,Auto">
    <ScrollViewer MaxHeight="440">
      <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Foreground="{DynamicResource ChatTextBrush}" />
    </ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,20,0,0">
      <Button x:Name="CancelButton" Content="Отмена" IsCancel="True" Click="OnCancel" />
      <Button Content="Удалить" Click="OnConfirm" />
    </StackPanel>
  </Grid>
</Window>
