<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MeshCoreMessenger.Desktop.ViewModels" xmlns:chat="using:MeshCoreMessenger.Desktop.Views.Chat"
             x:Class="MeshCoreMessenger.Desktop.Views.Chat.ChatsView" x:DataType="vm:MainWindowViewModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://MeshCoreMessenger.Desktop/Styles/ChatsStyles.axaml" />
  </UserControl.Styles>
  <Grid x:Name="Workspace" Classes="chat-workspace">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="{StaticResource ChatListWidth}" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <chat:ConversationListView x:Name="Directory" IsVisible="{Binding Navigation.IsDirectoryVisible}" />
    <chat:ConversationView x:Name="Detail" Grid.Column="1" IsVisible="{Binding Navigation.IsDetailVisible}" />
  </Grid>
</UserControl>
