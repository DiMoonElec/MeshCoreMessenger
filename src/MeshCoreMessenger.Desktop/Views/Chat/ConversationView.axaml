<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MeshCoreMessenger.Desktop.ViewModels" xmlns:chat="using:MeshCoreMessenger.Desktop.Views.Chat"
             xmlns:controls="using:MeshCoreMessenger.Desktop.Controls"
             x:Class="MeshCoreMessenger.Desktop.Views.Chat.ConversationView" x:DataType="vm:ChatWorkspaceViewModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://MeshCoreMessenger.Desktop/Styles/ConversationStyles.axaml" />
    <StyleInclude Source="avares://MeshCoreMessenger.Desktop/Styles/MentionStyles.axaml" />
  </UserControl.Styles>
  <Grid Classes="conversation" RowDefinitions="Auto,*,Auto">
    <Border Classes="conversation-header">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Content="‹" Command="{Binding Navigation.BackCommand}" IsVisible="{Binding Navigation.CanNavigateBack}" ToolTip.Tip="Назад к чатам" />
        <StackPanel Grid.Column="1" Classes="header-text">
          <TextBlock Classes="chat-title" Text="{Binding Navigation.SelectedTitle}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Navigation.SelectedTitle}" />
          <TextBlock Classes="chat-meta" Text="{Binding Navigation.SelectedMetadata}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button x:Name="ConversationMenuButton" Grid.Column="2" Classes="conversation-menu"
                IsVisible="{Binding Navigation.HasSelection}" ToolTip.Tip="Меню переписки"
                AutomationProperties.Name="Меню переписки">
          <!-- Use the PNG alpha mask, just like the navigation rail icons. -->
          <Border Width="24" Height="24" Background="{DynamicResource SystemControlForegroundBaseHighBrush}">
            <Border.OpacityMask>
              <ImageBrush Source="avares://MeshCoreMessenger.Desktop/Assets/Icons/chat_menu.png" />
            </Border.OpacityMask>
          </Border>
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight" Opening="OnConversationMenuOpening" ItemsSource="{Binding Menu.Items}">
              <MenuFlyout.ItemContainerTheme>
                <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:ConversationMenuItemViewModel">
                  <Setter Property="Header" Value="{Binding Header}" />
                  <Setter Property="Command" Value="{Binding Command}" />
                  <Setter Property="ToolTip.Tip" Value="{Binding AvailabilityMessage}" />
                  <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
                </ControlTheme>
              </MenuFlyout.ItemContainerTheme>
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </Border>
    <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto">
      <StackPanel Classes="history-tools" IsVisible="{Binding Navigation.HasSelection}">
        <TextBox x:Name="HistorySearch" PlaceholderText="Поиск в переписке" Text="{Binding Navigation.History.SearchText, Mode=TwoWay}" />
        <TextBlock Classes="chat-meta" Text="{Binding Navigation.History.SearchStatus}" IsVisible="{Binding Navigation.History.HasSearchStatus}" />
        <ListBox Classes="history-search-results" ItemsSource="{Binding Navigation.History.SearchResults}"
                 IsVisible="{Binding Navigation.History.HasSearchResults}" SelectionChanged="OnSearchSelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:HistorySearchResultListItem">
              <TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Button Content="Ещё результаты" Command="{Binding Navigation.History.LoadMoreSearchResultsCommand}" IsVisible="{Binding Navigation.History.CanLoadMoreSearchResults}" />
        <Button Content="{Binding Navigation.History.UnreadLabel}" Command="{Binding Navigation.History.JumpToFirstUnreadCommand}" IsVisible="{Binding Navigation.History.HasUnreadMessages}" />
      </StackPanel>
      <Grid Grid.Row="1">
        <controls:VirtualizedHistoryListBox x:Name="HistoryList" Classes="history" ItemsSource="{Binding Navigation.Messages}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:HistoryMessageListItem">
              <chat:MessageView OwnNodeName="{Binding $parent[chat:ConversationView].((vm:ChatWorkspaceViewModel)DataContext).ViewedNode.MentionName}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </controls:VirtualizedHistoryListBox>
        <TextBlock Classes="history-empty" Text="В этом чате пока нет сообщений" IsVisible="{Binding !Navigation.History.HasMessages}" />
      </Grid>
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
        <StackPanel Classes="history-tools">
          <Button Content="{Binding Navigation.History.PendingNewMessagesLabel}" Command="{Binding Navigation.History.JumpToLatestCommand}" IsVisible="{Binding Navigation.History.HasPendingNewMessages}" />
          <TextBlock Classes="chat-error" Text="{Binding HistoryClear.ErrorMessage}" TextWrapping="Wrap" IsVisible="{Binding HistoryClear.HasError}" />
          <TextBlock Classes="chat-error" Text="{Binding Navigation.History.ReadErrorMessage}" IsVisible="{Binding Navigation.History.HasReadError}" />
        </StackPanel>
        <Button x:Name="JumpToLatestButton" Grid.Column="1" Classes="history-jump" Command="{Binding Navigation.History.JumpToLatestCommand}"
                IsVisible="{Binding Navigation.HasSelection}" ToolTip.Tip="К последнему сообщению"
                AutomationProperties.Name="К последнему сообщению">
          <Path Width="20" Height="22" Stretch="Uniform" Data="M 10,0 L 10,20 M 2,12 L 10,20 L 18,12"
                Stroke="{DynamicResource ChatTextBrush}" StrokeThickness="2.5" />
        </Button>
      </Grid>
    </Grid>
    <Border Grid.Row="2" IsVisible="{Binding Navigation.HasSelection}">
      <chat:ComposerView DataContext="{Binding Composer}" />
    </Border>
  </Grid>
</UserControl>
