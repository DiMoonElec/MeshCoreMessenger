<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MeshCoreMessenger.Desktop.ViewModels"
             x:Class="MeshCoreMessenger.Desktop.Views.Dialogs.ContactDetailsCardView" x:DataType="vm:ContactDetailsCardViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.label"><Setter Property="Foreground" Value="{DynamicResource ChatMutedBrush}" /><Setter Property="Margin" Value="0,12,0,2" /></Style>
    <Style Selector="SelectableTextBlock"><Setter Property="Foreground" Value="{DynamicResource ChatTextBrush}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
  </UserControl.Styles>
  <StackPanel Spacing="4">
    <TextBlock Text="Чтение сохранённых сведений…" IsVisible="{Binding IsLoading}" Foreground="{DynamicResource ChatMutedBrush}" />
    <StackPanel IsVisible="{Binding HasError}" Spacing="8">
      <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource ChatErrorBrush}" />
      <Button Content="Обновить" Command="{Binding RetryCommand}" HorizontalAlignment="Left" />
    </StackPanel>
    <StackPanel IsVisible="{Binding HasDetails}" Spacing="4">
      <TextBlock Classes="label" Text="Имя" /><SelectableTextBlock Text="{Binding Details.Name}" FontSize="18" />
    </StackPanel>
    <TextBlock Classes="label" Text="Публичный ключ контакта" />
    <SelectableTextBlock Text="{Binding PublicKey}" />
    <StackPanel IsVisible="{Binding HasDetails}" Spacing="4">
      <TextBlock Classes="label" Text="Тип" /><SelectableTextBlock Text="{Binding Details.Type}" />
      <TextBlock Classes="label" Text="Справочник ноды" /><SelectableTextBlock Text="{Binding Details.Presence}" />
      <TextBlock Classes="label" Text="Маршрут отправки" /><SelectableTextBlock Text="{Binding Route}" />
      <TextBlock Classes="label" Text="Последний advert" /><SelectableTextBlock Text="{Binding Details.LastAdvert}" />
      <TextBlock Classes="label" Text="Координаты" /><SelectableTextBlock Text="{Binding Details.Coordinates}" />
      <TextBlock Text="{Binding Details.CoordinatesNote}" TextWrapping="Wrap" Foreground="{DynamicResource ChatMutedBrush}" />
      <TextBlock Classes="label" Text="Обновлено локально" /><SelectableTextBlock Text="{Binding Details.Updated}" />
      <Expander Header="Технические сведения" Margin="0,12,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <StackPanel>
          <TextBlock Classes="label" Text="Флаги" /><SelectableTextBlock Text="{Binding Details.Flags}" />
          <TextBlock Classes="label" Text="Дескриптор маршрута" /><SelectableTextBlock Text="{Binding Details.RouteDescriptor}" />
          <TextBlock Classes="label" Text="Поле маршрута (hex)" /><SelectableTextBlock Text="{Binding Details.RawRoute}" />
          <TextBlock Classes="label" Text="Advert (hex)" /><SelectableTextBlock Text="{Binding Details.RawAdvert}" />
        </StackPanel>
      </Expander>
    </StackPanel>
    <StackPanel DataContext="{Binding DeliveryHistory}" x:DataType="vm:ContactDeliveryHistoryViewModel" Spacing="8" Margin="0,20,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="Успешные доставки" FontSize="18" VerticalAlignment="Center" Foreground="{DynamicResource ChatTextBrush}" />
        <Button Grid.Column="1" Content="Обновить" Command="{Binding RefreshCommand}" />
      </Grid>
      <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource ChatMutedBrush}" />
      <TextBlock Text="Время ACK — по часам ПК. Снимки маршрута до отправки и после ACK не доказывают фактический путь пакета. Одна доставка может иметь несколько подтверждений."
                 TextWrapping="Wrap" Foreground="{DynamicResource ChatMutedBrush}" />
      <TextBlock Text="Чтение истории доставок…" IsVisible="{Binding IsLoading}" Foreground="{DynamicResource ChatMutedBrush}" />
      <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" Foreground="{DynamicResource ChatErrorBrush}" />
      <TextBlock Text="Успешных доставок пока нет." IsVisible="{Binding IsEmpty}" Foreground="{DynamicResource ChatMutedBrush}" />
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel MinWidth="560">
          <Grid ColumnDefinitions="140,175,165,80" Margin="0,4,0,8">
            <TextBlock Text="ACK / время ПК" Foreground="{DynamicResource ChatMutedBrush}" />
            <TextBlock Grid.Column="1" Text="Перед отправкой" Foreground="{DynamicResource ChatMutedBrush}" />
            <TextBlock Grid.Column="2" Text="После ACK" Foreground="{DynamicResource ChatMutedBrush}" />
            <TextBlock Grid.Column="3" Text="RTT" Foreground="{DynamicResource ChatMutedBrush}" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ContactDeliveryRowViewModel">
                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ChatMutedBrush}" Padding="0,10" ToolTip.Tip="{Binding Diagnostics}">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="140,175,165,80">
                      <SelectableTextBlock Text="{Binding AckTime}" Margin="0,0,8,0" />
                      <SelectableTextBlock Grid.Column="1" Text="{Binding ConfiguredRoutes}" Margin="0,0,8,0" />
                      <SelectableTextBlock Grid.Column="2" Text="{Binding LearnedRoute}" Margin="0,0,8,0" />
                      <SelectableTextBlock Grid.Column="3" Text="{Binding RoundTrip}" />
                    </Grid>
                    <TextBlock Text="{Binding Attribution}" TextWrapping="Wrap" Foreground="{DynamicResource ChatMutedBrush}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
      <Button Content="Показать ещё" Command="{Binding LoadMoreCommand}" IsVisible="{Binding HasMore}" HorizontalAlignment="Left" />
    </StackPanel>
  </StackPanel>
</UserControl>
