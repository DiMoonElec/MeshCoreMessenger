<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MeshCoreMessenger.Desktop.ViewModels" xmlns:domain="using:MeshCoreMessenger.Core.Domain"
             x:Class="MeshCoreMessenger.Desktop.Views.Settings.RegionSettingsView" x:DataType="vm:RegionSettingsViewModel">
  <StackPanel Spacing="16">
    <Border Classes="settings-card">
      <StackPanel Classes="settings-fields">
        <TextBlock Classes="settings-heading" Text="Регион по умолчанию на ноде" />
        <TextBlock Text="{Binding DefaultStatus}" TextWrapping="Wrap" />
        <TextBlock Classes="settings-hint" Text="Используется для ЛС и каналов в режиме «Как у ноды»." TextWrapping="Wrap" />
        <ComboBox ItemsSource="{Binding AvailableRegions}" SelectedItem="{Binding SelectedDefaultRegion, Mode=TwoWay}" PlaceholderText="Выберите регион" AutomationProperties.Name="Регион по умолчанию">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="domain:RegionCatalogEntry"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <WrapPanel><Button Content="Применить к ноде" Command="{Binding SetDefaultCommand}" Margin="0,0,8,8" /><Button Content="Без региона" Command="{Binding ClearDefaultCommand}" Margin="0,0,8,8" /></WrapPanel>
        <TextBlock Classes="settings-error" Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <Border Classes="settings-card">
      <StackPanel Classes="settings-fields" DataContext="{Binding CatalogSearch}" x:DataType="vm:RegionCatalogSearchViewModel">
        <WrapPanel>
          <Button Content="Поиск регионов" Command="{Binding SearchCommand}" Margin="0,0,8,8" />
          <Button Content="Отмена" Command="{Binding CancelCommand}" Margin="0,0,8,8" />
        </WrapPanel>
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsSearching}" AutomationProperties.Name="Поиск регионов выполняется" />
        <ItemsControl ItemsSource="{Binding Rows}" AutomationProperties.Name="Регионы">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RegionCatalogRowViewModel">
              <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />
                <Button Grid.Column="1" Content="{Binding Symbol}" Command="{Binding ToggleCommand}" AutomationProperties.Name="{Binding ActionName}" MinWidth="40" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
