<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MeshCoreMessenger.Desktop.ViewModels" xmlns:domain="using:MeshCoreMessenger.Core.Domain"
             x:Class="MeshCoreMessenger.Desktop.Views.Settings.RegionSettingsView" x:DataType="vm:RegionSettingsViewModel">
  <StackPanel Spacing="16">
    <Border Classes="settings-card">
      <StackPanel Classes="settings-fields">
        <TextBlock Classes="settings-heading" Text="Регион по умолчанию на ноде" />
        <TextBlock Text="{Binding DefaultStatus}" TextWrapping="Wrap" />
        <TextBlock Classes="settings-hint" Text="Используется для ЛС и каналов в режиме «Как у ноды». Изменяется на подключённой ноде только по кнопке." TextWrapping="Wrap" />
        <ComboBox ItemsSource="{Binding AvailableRegions}" SelectedItem="{Binding SelectedDefaultRegion, Mode=TwoWay}" PlaceholderText="Выберите регион" AutomationProperties.Name="Регион по умолчанию">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="domain:RegionCatalogEntry"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <WrapPanel><Button Content="Применить к ноде" Command="{Binding SetDefaultCommand}" Margin="0,0,8,8" /><Button Content="Без региона" Command="{Binding ClearDefaultCommand}" Margin="0,0,8,8" /></WrapPanel>
      </StackPanel>
    </Border>
    <Border Classes="settings-card">
      <StackPanel Classes="settings-fields">
        <TextBlock Classes="settings-heading" Text="Регионы" />
        <TextBlock Text="{Binding NodeLabel}" TextWrapping="Wrap" />
        <TextBlock Classes="settings-hint" Text="Локальный каталог текущей ноды. Добавление региона не меняет настройки устройства." TextWrapping="Wrap" />
        <Expander Header="Найти регионы у репитеров" HorizontalContentAlignment="Stretch">
          <StackPanel Spacing="8">
            <TextBlock Text="Поиск отправляет запросы в эфир. Разрешения ниже действуют только на этот запуск. Новые контакты останутся на ноде; временный маршрут восстанавливается при отсутствии новых изменений." TextWrapping="Wrap" />
            <CheckBox IsChecked="{Binding AllowContactCreation, Mode=TwoWay}"><TextBlock Text="Разрешить добавление отсутствующих контактов" TextWrapping="Wrap" /></CheckBox>
            <CheckBox IsChecked="{Binding AllowTemporaryZeroHop, Mode=TwoWay}"><TextBlock Text="Разрешить временный zero-hop маршрут" TextWrapping="Wrap" /></CheckBox>
            <WrapPanel><Button Content="Найти / повторить поиск" Command="{Binding SearchCommand}" Margin="0,0,8,8" /><Button Content="Отменить" Command="{Binding CancelSearchCommand}" Margin="0,0,8,8" /></WrapPanel>
            <TextBlock Text="{Binding DiscoveryStatus}" TextWrapping="Wrap" />
            <ComboBox ItemsSource="{Binding FoundRegions}" SelectedItem="{Binding SelectedFound, Mode=TwoWay}" PlaceholderText="Результаты поиска" AutomationProperties.Name="Найденные регионы">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:RegionDiscoveryListItem"><StackPanel><TextBlock Text="{Binding Name}" /><TextBlock Text="{Binding Note}" TextWrapping="Wrap" /><TextBlock Text="{Binding Sources}" TextTrimming="CharacterEllipsis" MaxWidth="320" ToolTip.Tip="{Binding Sources}" /></StackPanel></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="Добавить выбранный регион в каталог" Command="{Binding AddFoundCommand}" />
            <ItemsControl ItemsSource="{Binding DiscoveryOutcomes}">
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:RegionDiscoveryOutcomeItem"><StackPanel Margin="0,4"><TextBlock Text="{Binding Target}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Target}" /><TextBlock Text="{Binding Status}" TextWrapping="Wrap" /><TextBlock Text="{Binding Restoration}" TextWrapping="Wrap" Opacity="0.7" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Expander>
        <ComboBox ItemsSource="{Binding Catalog}" SelectedItem="{Binding Selected, Mode=TwoWay}" PlaceholderText="Выберите запись каталога" AutomationProperties.Name="Каталог регионов">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="domain:RegionCatalogEntry">
            <StackPanel><TextBlock Text="{Binding Label}" /><TextBlock Text="{Binding ProtocolName}" Opacity="0.65" /><TextBlock Text="В архиве" IsVisible="{Binding Archived}" /></StackPanel>
          </DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <TextBox Text="{Binding Label, Mode=TwoWay}" PlaceholderText="Название в каталоге" AutomationProperties.Name="Название региона" />
        <TextBox Text="{Binding ProtocolName, Mode=TwoWay}" PlaceholderText="Протокольное имя, например ru-ros" AutomationProperties.Name="Протокольное имя региона" />
        <Button Content="Добавить публичный регион" Command="{Binding AddPublicCommand}" />
        <Expander Header="Импортировать приватный регион" HorizontalContentAlignment="Stretch">
          <StackPanel Spacing="8">
            <TextBlock Text="Для имени $… нужен исходный ключ. Из имени он не вычисляется." TextWrapping="Wrap" />
            <TextBox Text="{Binding KeyHex, Mode=TwoWay}" PasswordChar="●" PlaceholderText="Ключ: 32 hex-символа" AutomationProperties.Name="Ключ приватного региона" />
            <Button Content="Импортировать" Command="{Binding ImportCommand}" />
          </StackPanel>
        </Expander>
        <WrapPanel Orientation="Horizontal">
          <Button Content="Переименовать" Command="{Binding RenameCommand}" Margin="0,0,8,8" />
          <Button Content="Архив / восстановить" Command="{Binding ArchiveCommand}" Margin="0,0,8,8" />
          <Button Content="Удалить" Command="{Binding DeleteCommand}" Margin="0,0,8,8" />
        </WrapPanel>
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
        <TextBlock Classes="settings-error" Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" />
        <Button Content="Обновить каталог" Command="{Binding RefreshCommand}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
