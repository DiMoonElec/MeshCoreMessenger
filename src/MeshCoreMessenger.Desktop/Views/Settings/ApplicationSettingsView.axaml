<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MeshCoreMessenger.Desktop.ViewModels"
             x:Class="MeshCoreMessenger.Desktop.Views.Settings.ApplicationSettingsView"
             x:DataType="vm:MainWindowViewModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://MeshCoreMessenger.Desktop/Styles/ApplicationSettingsStyles.axaml" />
  </UserControl.Styles>
  <ScrollViewer Classes="application-settings">
    <StackPanel Classes="settings-column">
      <TextBlock Classes="settings-heading" Text="Настройки" />
      <Border Classes="settings-card">
        <StackPanel Classes="settings-fields">
          <TextBlock Classes="settings-heading" Text="Оформление" />
          <TextBlock Classes="settings-label" Text="Тема" />
          <ComboBox ItemsSource="{Binding ThemeOptions}"
                    SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                    AutomationProperties.Name="Тема оформления">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DesktopThemeOption">
                <TextBlock Text="{Binding Title}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Classes="settings-hint"
                     Text="Авто — оформление как в системе. Выбранная тема применяется сразу." />
        </StackPanel>
      </Border>
      <Border Classes="settings-card">
        <StackPanel Classes="settings-fields">
          <TextBlock Classes="settings-heading" Text="Поведение окна" />
          <TextBlock Classes="settings-label" Text="После запуска" />
          <ComboBox ItemsSource="{Binding StartupWindowModeOptions}"
                    SelectedItem="{Binding SelectedStartupWindowMode, Mode=TwoWay}"
                    AutomationProperties.Name="Состояние окна после запуска">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DesktopStartupWindowModeOption">
                <TextBlock Text="{Binding Title}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Classes="settings-label" Text="При закрытии окна" />
          <ComboBox ItemsSource="{Binding CloseBehaviorOptions}"
                    SelectedItem="{Binding SelectedCloseBehavior, Mode=TwoWay}"
                    AutomationProperties.Name="Действие при закрытии окна">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DesktopCloseBehaviorOption">
                <TextBlock Text="{Binding Title}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Classes="settings-hint"
                     Text="Свёрнутое окно можно открыть через значок приложения в трее." />
        </StackPanel>
      </Border>
      <Border Classes="settings-card">
        <StackPanel Classes="settings-fields">
          <TextBlock Classes="settings-heading" Text="Уведомления" />
          <CheckBox HorizontalAlignment="Stretch" IsChecked="{Binding NotifyPrivateMessages, Mode=TwoWay}"
                    AutomationProperties.Name="Уведомления для личных сообщений">
            <TextBlock Text="Уведомления для личных сообщений" TextWrapping="Wrap" />
          </CheckBox>
          <CheckBox HorizontalAlignment="Stretch" IsChecked="{Binding NotifyChannelMessages, Mode=TwoWay}"
                    AutomationProperties.Name="Уведомления для каналов">
            <TextBlock Text="Уведомления для каналов" TextWrapping="Wrap" />
          </CheckBox>
          <TextBlock Classes="settings-hint"
                     Text="{Binding Notifications.StatusText}" />
          <Button Content="Разрешить в системе" IsVisible="{Binding Notifications.CanRequestPermission}"
                  Command="{Binding Notifications.RequestPermissionCommand}" />
        </StackPanel>
      </Border>
      <Border Classes="settings-card" IsVisible="{Binding HasPreferencesSaveError}">
        <StackPanel Classes="settings-fields">
          <TextBlock Classes="settings-error" Text="{Binding PreferencesSaveError}" />
          <Button Content="Повторить сохранение" Command="{Binding RetryPreferencesSaveCommand}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
