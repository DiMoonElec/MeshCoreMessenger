<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:MeshCoreMessenger.Desktop.Controls">
  <Style Selector="Grid.conversation">
    <Setter Property="Background" Value="{DynamicResource ChatCanvasBrush}" />
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource ChatTextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource ChatFontSize}" />
  </Style>
  <Style Selector="Border.conversation-header">
    <Setter Property="Background" Value="{DynamicResource ChatSurfaceBrush}" />
    <Setter Property="Padding" Value="{StaticResource ChatPanePadding}" />
  </Style>
  <Style Selector="StackPanel.header-text">
    <Setter Property="Margin" Value="{StaticResource ChatControlMargin}" />
  </Style>
  <Style Selector="TextBlock.chat-title">
    <Setter Property="FontSize" Value="{StaticResource ChatTitleFontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.chat-meta, TextBlock.message-date">
    <Setter Property="Foreground" Value="{DynamicResource ChatMutedBrush}" />
    <Setter Property="FontSize" Value="{StaticResource ChatMetaFontSize}" />
    <Setter Property="Margin" Value="{StaticResource ChatControlMargin}" />
  </Style>
  <Style Selector="StackPanel.history-tools">
    <Setter Property="Margin" Value="{StaticResource ChatControlMargin}" />
  </Style>
  <Style Selector="ListBox.history">
    <Setter Property="Background" Value="{DynamicResource ChatCanvasBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>
  <Style Selector="ListBox.history ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                          HorizontalContentAlignment="Stretch" />
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.history-search-results">
    <Setter Property="MaxHeight" Value="{StaticResource ChatComposerMaxHeight}" />
  </Style>
  <Style Selector="Button.history-jump">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="MinWidth" Value="44" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,8,24,12" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource ChatSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ChatSeparatorBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.history-jump:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ChatHoverBrush}" />
  </Style>
  <Style Selector="Button.history-jump:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ChatSelectedBrush}" />
  </Style>
  <Style Selector="TextBlock.history-empty">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource ChatMutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.chat-error">
    <Setter Property="Foreground" Value="{DynamicResource ChatErrorBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
</Styles>
