<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StyleInclude Source="avares://MeshCoreMessenger.Desktop/Styles/Typography.axaml" />
  <Style Selector="ScrollViewer.connection-settings">
    <Setter Property="Margin" Value="{StaticResource SettingsWorkspaceMargin}" />
    <Setter Property="Background" Value="{DynamicResource ChatCanvasBrush}" />
    <Setter Property="Padding" Value="{StaticResource SettingsPagePadding}" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>
  <Style Selector="StackPanel.settings-column">
    <Setter Property="MaxWidth" Value="{StaticResource SettingsColumnWidth}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Spacing" Value="{StaticResource SettingsSpacing}" />
  </Style>
  <Style Selector="Border.settings-card">
    <Setter Property="Background" Value="{DynamicResource ChatSurfaceBrush}" />
    <Setter Property="Padding" Value="{StaticResource SettingsCardPadding}" />
    <Setter Property="CornerRadius" Value="{StaticResource SettingsCardRadius}" />
  </Style>
</Styles>
